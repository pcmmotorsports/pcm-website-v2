_SGI_GATE="$_R/scripts/selftest-git-isolation-gate.sh"
_SGI_STAMP="$(git -C "$_R" rev-parse --git-dir 2>/dev/null)/selftest-isolation-gate.ok"
# 候選清單的撈法**逐字抄那道閘的候選式**(`selftest-git-isolation-gate.sh:698`)——
# 🔴 兩邊若分岔, 我們會替一組【它不會掃的檔】蓋章。
# 🔬 **而兩邊的分母差 2, 我查清楚了(2026-09-10)**:
#    我這一式撈到 **156** 支, 而那道閘印的分母是 **154** ——
#    差的正是它自己的具名排除清單 `NOENTRY`(`:135`)那兩支:
#      `scripts/b2s2b-verify.sh` · `scripts/scripts-whitelist-gate.harness.sh`
#    ⇒ ✅ **156 − 2 = 154, 對得起來, 不是尺壞了。**
#    🔵 **而我【刻意不扣那兩支】** —— 它們變動時我會多跑一次(它不掃它們)。
#      ⇒ 📌 那是往**安全**的方向偏:多跑不會漏, 少跑才會。
_sgi_fingerprint() {
  _sgi_cand="$( cd "$_R" && { git ls-files -z; git ls-files -z --others --exclude-standard; } | xargs -0 grep -l -- '--selftest' 2>/dev/null | sort -u | grep -E '^scripts/.*\.(py|sh)$' )" || return 1
  [ -n "$_sgi_cand" ] || return 1
  { printf '%s\n' "$_sgi_cand"
    ( cd "$_R" && printf '%s\n' "$_sgi_cand" | tr '\n' '\0' | xargs -0 cat )
    cat "$_SGI_GATE"
  } 2>/dev/null | shasum -a 256 2>/dev/null | awk '{print $1}' | grep -E '^[0-9a-f]{64}$'
}
_selftest_needed() {
  _sgi_now="$(_sgi_fingerprint)" || return 0
  [ -n "$_sgi_now" ] || return 0
  [ -r "$_SGI_STAMP" ] || return 0
  _sgi_old="$(cat "$_SGI_STAMP" 2>/dev/null)" || return 0
  [ "$_sgi_now" = "$_sgi_old" ] || return 0
  return 1
}
_selftest_run() {
  if _selftest_needed; then
    bash "$_SGI_GATE" < /dev/null || return $?
    # 🔵 只有真的跑過而且綠了才蓋章。寫失敗不擋推 —— 代價是下次再跑一次(安全的方向)。
    _sgi_now="$(_sgi_fingerprint)" && printf '%s\n' "$_sgi_now" > "$_SGI_STAMP" 2>/dev/null
    return 0
  fi
  # 🔴 不准只印 `skipped` —— 閘的訊息要說**我量了什麼**, 否則下一個人分不出它是判斷過還是壞掉。
  echo "⏭️  selftest 隔離閘:scripts/ 底下帶 --selftest 的腳本、以及閘自己, 內容與上次通過時" >&2
  echo "    完全相同(sha256 指紋)⇒ 跳過。🔵 它保護的是「腳本的 --selftest 會不會動到真 repo」," >&2
  echo "    沒有腳本變動就沒有新的受害者。🛑 指紋算不出來 / 沒蓋過章 ⇒ 它會【跑】不會跳過。" >&2
  return 0
}
