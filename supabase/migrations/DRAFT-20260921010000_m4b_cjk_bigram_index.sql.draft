--      printf '%s\n' "SELECT pg_catalog.pg_get_functiondef(p.oid) FROM pg_catalog.pg_proc p \
--        JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace \
--        WHERE n.nspname='public' AND p.proname='storefront_search_product_ids';" > /tmp/q.sql
