# Supabase(M-1-03-main-a1 起設定、對齊 ADR-0005)
# 真實值在 .env.local、絕不進 git
# Sean 從 Supabase Dashboard → Project Settings → API 取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJxxx_service_role_key_here

# 後續 milestone 加(M-3 / M-5 / M-6):
# TAPPAY_APP_KEY=
# TAPPAY_APP_ID=
# DATABASE_URL=
# DIRECT_URL=
# GCP_CREDENTIALS_PATH=~/Documents/pcm-credentials/gcp-sync-engine.json

# ── 排程存活訊號(healthchecks.io)⟦b4-CRON6⟧ 片3 ────────────────────────
# 🔴 這五個【只在正式站需要】。沒設 ⇒ 那支 check 停在 'new',而 'new' **不會告警**
#    ⇒ 【監控沒接上】與【還沒開始】長得一模一樣。設定步驟見
#    ~/pcm-mailbox/線D-清單-給Sean設的五個env-20260828.md
# ⚠️ 值是「**可以偽造成永遠健康**」的憑證(拿到的人可以送假的「我還活著」)
#    ⇒ 從 healthchecks 面板複製,不要讓它經過任何檔案或訊息。本檔只留空值。
# ⚠️ 第六支 pcm-expire-unpaid-orders 是純 SQL 排程,**它不該有這種變數**(不是漏掉)。
HEALTHCHECKS_PING_URL_PCM_ANOMALY_ALERT=
HEALTHCHECKS_PING_URL_PCM_CAPTURE_RECHECK=
HEALTHCHECKS_PING_URL_PCM_EMAIL_SWEEP=
HEALTHCHECKS_PING_URL_PCM_ORDER_INELIGIBLE_GATE=
HEALTHCHECKS_PING_URL_PCM_SETTLE_SWEEP=

# ── Cloudflare Turnstile 人機驗證(2026-09-26)──
# NEXT_PUBLIC_TURNSTILE_SITE_KEY:瀏覽器端顯示驗證用(公開值)。沒設 ⇒ 登入 / 註冊 / 忘記密碼不帶驗證碼,由 Supabase 決定擋不擋。
# TURNSTILE_SECRET_KEY:伺服器端驗證用(祕密值,只放 Vercel,www 與 b2b 兩個專案都要)。
#   目前只有「停用帳號按忘記密碼」那條路用得到(Sean Q30 / Q31 甲;見 lib/auth/disabled-account-notice.ts)。
#   🔴 必須跟上面那把 site key 成對、而且跟 Supabase Auth 的 captcha 設定是同一把 secret。
#   沒設 ⇒ 停用帳號按忘記密碼時不寄任何信, 畫面照常。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
