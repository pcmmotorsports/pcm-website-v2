{
  "name": "pcm-website-v2",
  "version": "0.0.0",
  "private": true,
  "description": "PCM重機零件販售 B2B/B2C 機車零件電商 + 車輛服務生態平台 — Phase 1 重做",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint 'scripts/*.ts' --max-warnings 0",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0 --no-error-on-unmatched-pattern --no-warn-ignored",
    "*.{sh,yaml,yml,sql}": "tsx scripts/check-syntax-nonts.ts",
    "scripts/pagecount.sh": "sh scripts/pagecount.sh --selftest",
    "scripts/migration-ledger-divergence.sh": "sh scripts/migration-ledger-divergence.sh --selftest",
    "{scripts/scripts-whitelist-gate.harness.sh,.husky/scripts-whitelist-gate.sh}": "sh scripts/scripts-whitelist-gate.harness.sh",
    "scripts/husky-hook-wiring-check.sh": "sh scripts/husky-hook-wiring-check.sh --selftest",
    ".husky/pre-*": "sh scripts/husky-hook-wiring-check.sh",
    "scripts/b2s2b-truth-sync.py": "bash scripts/b2s2b-tsync-cells.sh --selftest",
    "{supabase/migrations/20260806180000_m4b_e10_b2_s2b_shipped_recompute_wire.sql,supabase/migrations/20260813120000_m4b_e10_452_procurement_void_schema.sql,docs/runbooks/a4a-summary-rollback.md,scripts/a4a-verify.sh}": "python3 scripts/b2s2b-truth-sync.py .",
    "{scripts/b2s2b-tsync-cells.sh,scripts/b2s2b-verify.sh}": "bash scripts/b2s2b-tsync-cells.sh --selftest",
    "scripts/stale-commit-msgs.py": "python3 scripts/stale-commit-msgs.py --selftest"
  },
  "devDependencies": {
    "@pcm/domain": "workspace:^",
    "@supabase/supabase-js": "^2.105.3",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.0.4",
    "pg": "^8.21.0",
    "sharp": "0.34.5",
    "tsx": "^4.22.4",
    "turbo": "^2.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.6.0",
    "zod": "catalog:"
  }
}
